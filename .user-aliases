# OS
alias cat='bat'
alias ll="eza -la -g --icons"
alias ls="eza --color=always --long --git --icons=always"
alias lt="eza --tree --icons -a -I '.git|__pycache__|.mypy_cache|.ipynb_checkpoints'"
alias as="alias | grep"
alias vim="nvim"
alias v="vim"
alias p="pamac"

alias f="fuck"

# Git
alias gg='lazygit'
alias lg='lazygit'

# DOCKER
alias doc='docker-compose'
alias docu='docker-compose up -d'
alias doce='docker-compose exec'
alias d='docker'
alias dd='lazydocker'
alias ld='lazydocker'

# Cell Home wifi band control (shared SSID across 2.4/5 GHz)
alias wifi5='nmcli connection modify "Cell Home" wifi.band a && nmcli connection up "Cell Home"'
alias wifiauto='nmcli connection modify "Cell Home" wifi.band "" && nmcli connection up "Cell Home"'
